## KK_ExpressionLink 0.5.1 example
## BepInEx creates the live file automatically at:
## BepInEx/config/com.nightowlzzz.koikatsu.eyemotion.cfg

[General]
Enabled = true
RestoreMode = InitialValues

[Target Headmod]
TargetRendererPath =
TargetRendererName =
SearchScope = HeadFirst
RequireAllDirectionalBlendshapes = true
RequireBlinkWhenEnabled = true
BindingRetryFrames = 60

[Blendshape Names]
PositiveXBlendshape = eye_motion.f00_eye_posx
NegativeXBlendshape = eye_motion.f00_eye_negx
PositiveYBlendshape = eye_motion.f00_eye_posy
NegativeYBlendshape = eye_motion.f00_eye_negy
BlinkBlendshape = eye_motion.f00_eye_blink

[Horizontal Movement]
InvertX = false
SourceEyeMode = Average
ClampInputToUnitCircle = true
HorizontalCenterOffset = 0
PositiveXInputLimit = 1
NegativeXInputLimit = 1
PositiveXMaxWeight = 100
NegativeXMaxWeight = 100
PositiveXDeadZone = 0
NegativeXDeadZone = 0
PositiveXGamma = 1
NegativeXGamma = 1

[Vertical Movement]
InvertY = false
VerticalCenterOffset = 0
PositiveYInputLimit = 1
NegativeYInputLimit = 1
PositiveYMaxWeight = 100
NegativeYMaxWeight = 100
PositiveYDeadZone = 0
NegativeYDeadZone = 0
PositiveYGamma = 1
NegativeYGamma = 1

[Blink]
BlinkEnabled = true
BlinkMaxWeight = 100
BlinkDeadZone = 0
BlinkGamma = 1
BlinkSmoothingSpeed = 0

[Smoothing]
SmoothingEnabled = false
SmoothingSpeed = 12
UseUnscaledTime = false

[ExpressionControl Eye Adjustments]
Enabled = true
IrisYMaxWeight = 100
IrisSizeMaxWeight = 100

[ExpressionControl Eye Adjustment Blendshapes]
## Optional channels that are authored must share the selected renderer with
## the required gaze/blink shapes.
IrisYBlendshape = eye_motion.f00_iris_y
IrisSizeBlendshape = eye_motion.f00_iris_size

## IrisY maps 0..0.5 to 0..IrisYMaxWeight.
## Size maps 0..1 to 0..IrisSizeMaxWeight and represents iris shrink.
## KK_ExpressionControl.dll is optional. Without it these shapes are not
## controlled; gaze, blink, visibility, highlights, and expressions still work.

[Manual Visibility]
HideBlendshapeWeight = 100
FollowBaseGameHighlightVisibility = true

[Manual Visibility Blendshapes]
Highlight01Blendshape = eye_motion.f00_hide_highlight01
Highlight02Blendshape = eye_motion.f00_hide_highlight02
IrisInnerBlendshape = eye_motion.f00_hide_irisinner
IrisOuterBlendshape = eye_motion.f00_hide_irisouter
PupilBlendshape = eye_motion.f00_hide_pupil
ScleraBlendshape = eye_motion.f00_hide_sclera
NormalEyesBlendshape = eye_motion.f00_hide_normaleyes

## Expression-driven blendshapes are per-character card data. Create them in
## Quick Settings > Expressions. A link can target an exact blendshape on the
## head, hair, body, clothes, accessories, or another character-owned renderer.
## Reusable link sets are not global configuration entries.

[Persistence]
CardPersistenceEnabled = true

## Schema 3 saves per-character Expression Links alongside the historical 10+4
## visibility layout and four renderer-trigger strings. Older card values are
## read, preserved, and executed internally, but are not a new-authoring flow.
## Schema 1 and schema 2 cards remain compatible. Reusable JSON profiles are
## stored separately under:
## BepInEx/config/KK_ExpressionLink/Profiles
## KKS is not supported by this build.

[Diagnostics]
DebugLogging = false
LogEyeValues = false
LogIntervalSeconds = 2
QuickSettingsShortcut = M + LeftControl + LeftShift
DumpDiagnosticsShortcut = F10 + LeftShift
